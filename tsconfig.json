{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "./build",
    "rootDir": "./",
    "baseUrl": "./",
    "paths": {
      "@adonisjs/attachment-lite": ["./index.ts"],
      "@adonisjs/attachment-lite/*": ["./*"]
    }
  },
  "include": [
    "src/**/*",
    "providers/**/*",
    "configure.ts",
    "index.ts",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}
