{
  "name": "@cn/attachment-lite",
  "version": "2.0.0",
  "description": "Convert fields on Lucid models to attachment data type",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "type": "module",
  "files": [
    "build",
    "src",
    "providers",
    "configure.ts",
    "index.ts"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "del-cli build",
    "test": "node --import=ts-node-maintained/register/esm --enable-source-maps bin/test.ts",
    "pretest": "npm run build"
  },
  "keywords": [
    "adonisjs",
    "lucid",
    "orm",
    "attachment",
    "file-upload"
  ],
  "author": "AdonisJS",
  "license": "MIT",
  "peerDependencies": {
    "@adonisjs/core": "^6.0.0",
    "@adonisjs/drive": "^3.4.1",
    "@adonisjs/lucid": "^19.0.0"
  },
  "dependencies": {
    "@japa/assert": "^4.0.1",
    "@poppinss/utils": "^6.7.1",
    "ts-node-maintained": "^10.9.5"
  },
  "devDependencies": {
    "@adonisjs/core": "^6.0.0",
    "@adonisjs/drive": "^3.4.1",
    "@adonisjs/lucid": "^19.0.0",
    "@japa/runner": "^3.0.0",
    "@types/node": "^20.0.0",
    "del-cli": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "compilerOptions": {
    "paths": {
      "@cn/attachment-lite/*": ["./node_modules/@cn/attachment-lite/*"]
    }
  }
}
